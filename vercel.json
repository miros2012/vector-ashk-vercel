{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm test && mkdir -p public && printf 'ok\\n' > public/index.txt",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**/*": false,
      "main": true,
      "preview-*": true,
      "release-*": true
    }
  },
  "functions": {
    "api/master-hours-diagnostic.js": { "maxDuration": 60 },
    "api/sync-hours.js": { "maxDuration": 60 },
    "api/sync-payments.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/sync-hours",
      "schedule": "30 21 * * *"
    }
  ]
}
