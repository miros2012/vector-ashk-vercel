{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**/*": false,
      "main": true
    }
  },
  "rewrites": [
    { "source": "/api/owner-action", "destination": "/api/decision-event?ownerRoute=action" },
    { "source": "/api/decision-effectiveness", "destination": "/api/decision-event?ownerRoute=effectiveness" },
    { "source": "/api/owner-action-queue", "destination": "/api/decision-event?ownerRoute=queue" },
    { "source": "/api/owner-package", "destination": "/api/decision-event?ownerRoute=package" },
    { "source": "/api/owner-dashboard-session", "destination": "/api/decision-event?ownerRoute=dashboard-session" },
    { "source": "/api/owner-dashboard-data", "destination": "/api/decision-event?ownerRoute=dashboard-data" },
    { "source": "/api/owner-dashboard-google", "destination": "/api/decision-event?ownerRoute=dashboard-google" }
  ],
  "headers": [
    {
      "source": "/owner/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/health.js": { "maxDuration": 60 },
    "api/master-hours-diagnostic.js": { "maxDuration": 60 },
    "api/sync-hours.js": { "maxDuration": 60 },
    "api/sync-payments.js": { "maxDuration": 60 },
    "api/nightly-finance-orchestrator.js": { "maxDuration": 180 },
    "api/github-finance-sync.js": { "maxDuration": 180 }
  },
  "crons": [
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 21 * * *" },
    { "path": "/api/health", "schedule": "35 21 * * *" }
  ]
}
