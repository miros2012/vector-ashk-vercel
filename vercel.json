{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**/*": false,
      "main": true,
      "preview-*": true,
      "release-*": true
    }
  },
  "functions": {
    "api/master-hours-diagnostic.js": { "maxDuration": 60 },
    "api/sync-hours.js": { "maxDuration": 60 },
    "api/sync-payments.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/decision-reconcile-daily",
      "schedule": "15 0 * * *"
    }
  ]
}
