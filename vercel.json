{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview-*": true,
      "release-*": true
    }
  },
  "functions": {
    "api/master-hours-diagnostic.js": { "maxDuration": 60 },
    "api/sync-hours.js": { "maxDuration": 60 },
    "api/sync-payments.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/sync-hours?month=previous",
      "schedule": "20 21 1-3 * *"
    },
    {
      "path": "/api/sync-hours",
      "schedule": "30 21 * * *"
    }
  ]
}
