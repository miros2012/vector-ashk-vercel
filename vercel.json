{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**/*": false,
      "main": true
    }
  },
  "rewrites": [
    { "source": "/api/owner-action", "destination": "/api/decision-event?ownerRoute=action" },
    { "source": "/api/decision-effectiveness", "destination": "/api/decision-event?ownerRoute=effectiveness" },
    { "source": "/api/owner-action-queue", "destination": "/api/decision-event?ownerRoute=queue" },
    { "source": "/api/owner-package", "destination": "/api/decision-event?ownerRoute=package" },
    { "source": "/api/owner-dashboard-session", "destination": "/api/decision-event?ownerRoute=dashboard-session" },
    { "source": "/api/owner-dashboard-data", "destination": "/api/decision-event?ownerRoute=dashboard-data" },
    { "source": "/api/owner-dashboard-google", "destination": "/api/decision-event?ownerRoute=dashboard-google" },
    { "source": "/api/cash-photo-retry-cron", "destination": "/api/health?cashPhotoRoute=retry-cron" }
  ],
  "headers": [
    {
      "source": "/owner/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/health.js": { "maxDuration": 60 },
    "api/master-hours-diagnostic.js": { "maxDuration": 180 },
    "api/sync-hours.js": { "maxDuration": 60 },
    "api/sync-payments.js": { "maxDuration": 60 },
    "api/nightly-finance-orchestrator.js": { "maxDuration": 180 }
  },
  "crons": [
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 21 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 4 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 5 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 6 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 7 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 8 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 9 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 10 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 11 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 12 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 13 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 14 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "0 15 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 4 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 5 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 6 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 7 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 8 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 9 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 10 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 11 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 12 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 13 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 14 * * *" },
    { "path": "/api/nightly-finance-orchestrator", "schedule": "30 15 * * *" },
    { "path": "/api/health", "schedule": "35 21 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "45 21 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 4 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 5 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 6 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 7 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 8 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 9 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 10 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 11 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 12 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 13 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 14 * * *" },
    { "path": "/api/cash-photo-retry-cron", "schedule": "15 15 * * *" }
  ]
}
